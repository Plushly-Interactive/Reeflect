{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reeflect",
  "version": "0.1.0",
  "identifier": "app.reeflect",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node ../scripts/os/assemble.mjs --app"
  },
  "app": {
    "windows": [
      {
        "title": "Reeflect",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "url": "src/pages/dashboard/dashboard.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
